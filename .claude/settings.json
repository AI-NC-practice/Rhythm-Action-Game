{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/:*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push origin main)",
      "mcp__varco-3d"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/hooks/session-start.ps1" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/hooks/protect-gdd.ps1" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/hooks/git-guard.ps1", "timeout": 60 }
        ]
      },
      {
        "matcher": "mcp__varco-3d__.*",
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/hooks/varco-guard.ps1", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/scripts/hooks/stop-check.ps1", "timeout": 30 }
        ]
      }
    ]
  }
}
